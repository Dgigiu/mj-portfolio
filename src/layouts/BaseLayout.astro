---
import "../styles/global.css";

import Nav from "../components/Nav.astro";
import Footer from "../components/Footer.astro";
import ZoomDialog from "../components/ZoomDialog.astro";
import { base } from "../lib/paths";
import { UMAMI_DOMAINS, UMAMI_SCRIPT_SRC, UMAMI_WEBSITE_ID } from "../lib/analytics";

interface Props {
  title: string;
  description?: string;
  // Full site-root-relative path (already including `base`), e.g. the
  // default below or a getImage() result's .src for a per-page image.
  ogImage?: string;
}

const {
  title,
  description = "Miguel Jesus, Senior Product Designer based in Porto. Portfolio of product case studies across SaaS and mobile.",
  ogImage = `${base}og/default.png`,
} = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site).toString();
// The github.io staging deploy must not be indexed: its /mj-portfolio/...
// URLs break at the domain switch (GitHub redirects the host but keeps the
// path). Keyed off the site host so it clears automatically once `site`
// becomes migueljss.com.
const isStaging = Astro.site?.hostname.endsWith("github.io") ?? false;
const ogImageUrl = new URL(ogImage, Astro.site).toString();
const fullTitle = title === "Miguel Jesus" ? title : `${title} · Miguel Jesus`;
const loadAnalytics = import.meta.env.PROD && UMAMI_WEBSITE_ID !== "";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    {isStaging && <meta name="robots" content="noindex" />}
    <link rel="canonical" href={canonical} />

    <meta property="og:type" content="website" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImageUrl} />
    <meta name="twitter:card" content="summary_large_image" />

    <link rel="icon" type="image/svg+xml" href={`${base}favicon.svg`} />
    <link rel="apple-touch-icon" href={`${base}apple-touch-icon.png`} />
    <link rel="sitemap" href={`${base}sitemap-index.xml`} />

    <meta name="theme-color" content="#fbfaf6" />

    <!-- Gates the [data-reveal] hidden state (global.css): must run before
         first paint so content never flashes, and stays visible without JS. -->
    <script is:inline>document.documentElement.classList.add("js");</script>

    {
      loadAnalytics && (
        <script
          is:inline
          defer
          src={UMAMI_SCRIPT_SRC}
          data-website-id={UMAMI_WEBSITE_ID}
          data-domains={UMAMI_DOMAINS}
        />
      )
    }

    <slot name="head" />
  </head>
  <body>
    <a href="#main" class="visually-hidden">Skip to content</a>
    <Nav />
    <main id="main">
      <slot />
    </main>
    <Footer />

    <ZoomDialog />

    <script>
      import { tagReferral } from "../lib/analytics";

      tagReferral();

      const host = window.location.host;
      document.querySelectorAll<HTMLAnchorElement>('a[href^="http"]').forEach((a) => {
        try {
          if (new URL(a.href).host !== host) {
            a.target = "_blank";
            const rel = new Set((a.rel || "").split(/\s+/).filter(Boolean));
            rel.add("noopener");
            rel.add("noreferrer");
            a.rel = Array.from(rel).join(" ");
          }
        } catch {}
      });

      // Scroll reveals: flip [data-reveal] elements visible the first time
      // they enter the viewport. The hidden state only exists under
      // html.js + no reduced-motion (global.css), so this is purely additive.
      const revealEls = document.querySelectorAll<HTMLElement>("[data-reveal]");
      if ("IntersectionObserver" in window) {
        const io = new IntersectionObserver(
          (entries) => {
            for (const entry of entries) {
              if (!entry.isIntersecting) continue;
              entry.target.classList.add("is-revealed");
              io.unobserve(entry.target);
            }
          },
          // Fire as soon as the element's edge enters: the effect is faint
          // enough that finishing early reads smoother than a late pop.
          { threshold: 0 }
        );
        revealEls.forEach((el) => io.observe(el));
      } else {
        revealEls.forEach((el) => el.classList.add("is-revealed"));
      }
    </script>
  </body>
</html>
