---
import type { MarkdownHeading } from "astro";
import { getCollection } from "astro:content";
import { Image, getImage } from "astro:assets";
import BaseLayout from "./BaseLayout.astro";
import CaseStudyCard from "../components/CaseStudyCard.astro";
import ContactOutro from "../components/ContactOutro.astro";
import JumpList from "../components/JumpList.astro";
import { base } from "../lib/paths";

interface Props {
  title: string;
  summary: string;
  outcomes?: string[];
  role: string;
  period: string;
  client: string;
  domain: string;
  banner?: ImageMetadata;
  slug: string;
  headings?: MarkdownHeading[];
}

const { title, summary, outcomes, role, period, client, domain, banner, slug, headings = [] } = Astro.props;

// Per-case OG/share image, derived from the same cover used for the hero
// and cards. getImage()'s .src already includes `base`, so it can be passed
// straight through to BaseLayout without any extra path handling.
const ogImage = banner
  ? (await getImage({ src: banner, width: 1200, height: 630, fit: "cover", format: "webp" })).src
  : undefined;

const more = (
  await getCollection("case-studies", ({ data }) => !data.draft)
)
  .filter((entry) => entry.slug !== slug)
  .sort((a, b) => a.data.order - b.data.order);
---

<BaseLayout title={title} description={summary} ogImage={ogImage}>
  <header class="case-header">
    <div class="container">
      <div class="case-header-inner">
        <p class="mj-eyebrow">CASE STUDY · {client}</p>
        <h1 class="case-title">{title}</h1>
        <p class="case-summary">{summary}</p>
        <p class="case-meta">{role} · {period} · {domain}</p>
        {
          outcomes && outcomes.length > 0 && (
            <ul class="case-outcomes" aria-label="Outcomes">
              {outcomes.map((outcome) => <li>{outcome}</li>)}
            </ul>
          )
        }
      </div>
    </div>
  </header>

  {
    banner && (
      <div class="case-cover">
        <div class="container">
          <Image
            src={banner}
            alt={`${title} project cover`}
            widths={[960, 1440, 1920]}
            sizes="(min-width: 960px) 960px, 100vw"
            class="cover-img"
            loading="eager"
            fetchpriority="high"
          />
        </div>
      </div>
    )
  }

  <article class="case-body container">
    {headings.length > 1 && <JumpList headings={headings} caseSlug={slug} />}
    <div class="prose">
      <slot />
    </div>
    <div data-read-marker data-case={slug} aria-hidden="true"></div>
  </article>

  {
    more.length > 0 && (
      <section class="more container">
        <header class="more-head">
          <h2>More case studies</h2>
        </header>
        <ul class="more-list">
          {more.map((s) => (
            <li data-reveal>
              <CaseStudyCard
                href={`${base}work/${s.slug}/`}
                title={s.data.title}
                summary={s.data.summary}
                client={s.data.client}
                domain={s.data.domain}
                period={s.data.period}
                cover={s.data.banner}
                compact
              />
            </li>
          ))}
        </ul>
      </section>
    )
  }

  <ContactOutro />
</BaseLayout>

<script>
  import { track } from "../lib/analytics";

  // "Case study read": the reader reached the end of the article body, past
  // the learnings. Fires once per page view.
  const marker = document.querySelector<HTMLElement>("[data-read-marker]");
  if (marker && "IntersectionObserver" in window) {
    const io = new IntersectionObserver((entries) => {
      if (!entries.some((entry) => entry.isIntersecting)) return;
      track("Case study read", { case: marker.dataset.case ?? "" });
      io.disconnect();
    });
    io.observe(marker);
  }
</script>

<style>
  .case-header {
    padding: var(--space-16) 0 var(--space-12);
  }

  .case-header-inner {
    max-width: var(--content-prose);
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
  }

  .case-title {
    font-family: var(--font-sans);
    font-weight: var(--weight-semi);
    font-size: var(--text-4xl);
    line-height: var(--leading-tight);
    letter-spacing: var(--tracking-snug);
    color: var(--fg-primary);
    margin: 0;
  }

  .case-summary {
    font-family: var(--font-serif);
    font-size: var(--text-lg);
    line-height: var(--leading-relaxed);
    color: var(--fg-secondary);
    margin: 0;
  }

  .case-meta {
    font-family: var(--font-sans);
    font-size: var(--text-xs);
    line-height: var(--leading-normal);
    color: var(--fg-tertiary);
    margin: 0;
  }

  /* Results the summary can't carry. Hairline top rule like Stat, and the
     same en-dash marker as prose lists, at a quieter size and ink. */
  .case-outcomes {
    list-style: none;
    margin: 0;
    padding: var(--space-4) 0 0;
    border-top: var(--hairline) solid var(--border-subtle);
  }

  .case-outcomes li {
    position: relative;
    padding-left: 1.6em;
    font-family: var(--font-sans);
    font-size: var(--text-sm);
    line-height: var(--leading-normal);
    color: var(--fg-secondary);
  }

  .case-outcomes li + li {
    margin-top: var(--space-2);
  }

  .case-outcomes li::before {
    content: "–";
    position: absolute;
    left: 0;
    color: var(--accent);
    font-weight: var(--weight-semi);
  }

  .case-cover {
    padding-bottom: var(--space-12);
  }

  /* Cover is a fixed 1200:630 strip across all cases, matching the OG image
     ratio since this same source also generates it. aspect-ratio reserves
     the space (no layout shift) and object-fit: cover guards against an
     export that isn't exactly 1200:630. Source is exported 1920×1008. */
  .cover-img {
    width: 100%;
    max-width: var(--content-wide);
    aspect-ratio: 1200 / 630;
    height: auto;
    object-fit: cover;
    border-radius: var(--radius-md);
    display: block;
  }

  .case-body {
    padding-bottom: var(--space-16);
  }

  /* Flush-left: prose shares its left edge with the 720 header and the
     960 cover above. Same spine, three widths. */
  .case-body .prose {
    margin-inline: 0;
  }

  /* Anchored section headings clear the sticky nav when jumped to. */
  .case-body .prose :global(h2),
  .case-body .prose :global(h3) {
    scroll-margin-top: var(--space-24);
  }

  /* From 1024px the jump list rides beside the prose in the 224px the page
     container leaves free (JumpList switches at the same width). It spans
     both rows so it sticks until the article ends, clear of "More case
     studies". A bleed figure would run into it, so it bleeds left only. */
  @media (min-width: 1024px) {
    .case-body {
      display: grid;
      grid-template-columns: var(--content-prose) minmax(0, 1fr);
      column-gap: var(--space-10);
      align-items: start;
    }

    .case-body .prose {
      grid-area: 1 / 1;
    }

    .case-body [data-read-marker] {
      grid-area: 2 / 1;
    }

    .case-body :global(.jump) {
      grid-column: 2;
      grid-row: 1 / span 2;
    }

    .case-body :global(.figure.bleed) {
      margin-inline-end: 0;
    }
  }

  /* padding-block, not the shorthand: .more is a .container and the
     shorthand would zero out its safe-zone padding-inline. */
  .more {
    padding-block: var(--space-16);
    border-top: var(--hairline) solid var(--border-subtle);
  }

  .more-head {
    margin-bottom: var(--space-8);
  }

  .more-head h2 {
    font-family: var(--font-sans);
    font-weight: var(--weight-semi);
    letter-spacing: var(--tracking-snug);
    color: var(--fg-primary);
    margin: 0;
  }

  .more-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
    gap: var(--space-8);
  }

  @media (max-width: 640px) {
    .case-title {
      font-size: var(--text-3xl);
    }
  }
</style>
