---
import { Image } from "astro:assets";

interface Props {
  href: string;
  title: string;
  summary: string;
  benefit?: string;
  client?: string;
  domain?: string;
  period?: string;
  cover?: ImageMetadata;
  compact?: boolean;
}

const { href, title, summary, benefit, client, domain, period, cover, compact = false } = Astro.props;

const metaParts = compact
  ? [client].filter(Boolean)
  : [client, domain, period].filter(Boolean);

// When a benefit lead is present it's authored as the summary's first
// sentence, so strip it from the summary to get the description and avoid
// printing the same line twice. Falls back to the full summary if it doesn't
// prefix-match (e.g. the field was edited independently).
const description =
  benefit && summary.startsWith(benefit) ? summary.slice(benefit.length).trim() : summary;
---

<a href={href} class:list={["card", { compact }]}>
  <div class="card-media">
    {
      cover ? (
        <Image
          src={cover}
          alt=""
          widths={[480, 800, 1200]}
          sizes="(min-width: 1040px) 456px, (min-width: 720px) 50vw, 100vw"
        />
      ) : (
        <div class="card-placeholder" aria-hidden="true">
          <span>{title}</span>
        </div>
      )
    }
  </div>
  <div class="card-body">
    {compact && metaParts.length > 0 && <p class="card-meta">{metaParts.join(" · ")}</p>}
    <h3 class="card-title">{title}</h3>
    {!compact && benefit && <p class="card-benefit">{benefit}</p>}
    {!compact && <p class="card-summary">{description}</p>}
    {!compact && metaParts.length > 0 && <p class="card-meta">{metaParts.join(" · ")}</p>}
    {!compact && <span class="card-cta" aria-hidden="true">Read the case study →</span>}
  </div>
</a>

<style>
  .card {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: var(--space-8);
    align-items: center;
    text-decoration: none;
    color: var(--fg-primary);
  }

  .card:focus-visible {
    outline: none;
    box-shadow: var(--shadow-focus);
    border-radius: var(--radius-sm);
  }

  /* Hover lift: shadow deepens, the frame rises 2px, and the image
     scales a hair inside it. Media only; the card text stays put. */
  .card-media {
    aspect-ratio: 1200 / 630;
    border-radius: var(--radius-md);
    overflow: hidden;
    background: var(--bg-subtle);
    box-shadow: var(--shadow-sm);
    transition: box-shadow var(--duration-normal) var(--ease-out),
                translate var(--duration-normal) var(--ease-out);
  }

  .card:hover .card-media {
    box-shadow: var(--shadow-md);
    translate: 0 -2px;
  }

  .card-media :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: scale var(--duration-normal) var(--ease-out);
  }

  .card:hover .card-media :global(img) {
    scale: 1.01;
  }

  .card-placeholder {
    width: 100%;
    height: 100%;
    display: grid;
    place-items: center;
    color: var(--fg-tertiary);
    font-family: var(--font-sans);
    font-weight: var(--weight-semi);
    font-size: var(--text-2xl);
    letter-spacing: var(--tracking-snug);
    padding: var(--space-5);
    text-align: center;
  }

  .card-body {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }

  .card-meta {
    font-family: var(--font-sans);
    font-size: var(--text-xs);
    line-height: var(--leading-normal);
    color: var(--fg-tertiary);
    margin: 0;
  }

  .card-title {
    font-family: var(--font-sans);
    font-weight: var(--weight-semi);
    font-size: var(--text-2xl);
    line-height: var(--leading-snug);
    letter-spacing: var(--tracking-snug);
    color: var(--fg-primary);
    margin: 0;
  }

  /* Benefit lead: serif standfirst in primary ink, a step up in size from
     the description so it reads as the line that frames the case. Stays a
     static type voice (no accent): blue is reserved for the CTA below. */
  .card-benefit {
    font-family: var(--font-serif);
    font-size: var(--text-lg);
    line-height: var(--leading-snug);
    color: var(--fg-primary);
    margin: 0;
  }

  .card-summary {
    font-family: var(--font-serif);
    font-size: var(--text-md);
    line-height: var(--leading-relaxed);
    color: var(--fg-secondary);
    margin: 0;
  }

  .card-cta {
    font-family: var(--font-sans);
    font-size: var(--text-sm);
    color: var(--accent);
    margin-top: var(--space-2);
  }

  /* Compact (image-on-top, vertical) variant for "More case studies" */
  .card.compact {
    grid-template-columns: 1fr;
    gap: var(--space-4);
    align-items: start;
  }

  .card.compact .card-media {
    aspect-ratio: 1200 / 630;
  }

  .card.compact .card-title {
    font-size: var(--text-lg);
    letter-spacing: var(--tracking-normal);
  }

  @media (max-width: 720px) {
    .card:not(.compact) {
      grid-template-columns: 1fr;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .card-media,
    .card-media :global(img) {
      transition: none;
    }

    .card:hover .card-media {
      translate: none;
    }

    .card:hover .card-media :global(img) {
      scale: none;
    }
  }
</style>
