---
const year = new Date().getFullYear();
---

<footer class="footer">
  <div class="container footer-inner">
    <p class="meta">© {year} Miguel Jesus · Designing with clarity and calm purpose since 2005.</p>
    <div class="social">
      <a
        href="https://www.linkedin.com/in/migueljss/"
        target="_blank"
        rel="me noopener noreferrer"
        class="social-link"
      >LinkedIn</a>
      <a
        href="mailto:miguel.jss@gmail.com?subject=Hello%20from%20migueljss.com"
        class="social-link"
      >Email</a>
    </div>
  </div>
</footer>

<style>
  /* Darker-cobalt base strip. Sits flush under the cobalt contact band on
     home and case pages (a two-tone cobalt foot), and as a self-contained
     end-cap on about/contact, which have no band above. No top margin: the
     color change is the seam. */
  .footer {
    background: var(--accent-press);
    padding: var(--space-8) 0;
  }

  .footer-inner {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-4);
    justify-content: space-between;
    align-items: center;
  }

  .meta {
    font-family: var(--font-sans);
    font-size: var(--text-xs);
    line-height: var(--leading-normal);
    color: rgba(255, 255, 255, 0.78);
    margin: 0;
  }

  .social {
    display: flex;
    gap: var(--space-4);
  }

  .social-link {
    font-family: var(--font-sans);
    font-size: var(--text-xs);
    color: rgba(255, 255, 255, 0.78);
    text-decoration: none;
    transition: color var(--duration-fast) var(--ease-out);
  }

  .social-link:hover {
    color: #fff;
  }

  @media (max-width: 480px) {
    .footer-inner {
      flex-direction: column;
      align-items: flex-start;
      gap: var(--space-3);
    }
  }
</style>
