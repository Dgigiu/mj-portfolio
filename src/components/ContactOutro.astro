---
/* Shared end-of-page contact beat: home and case study pages close on the
   same quiet invitation, with the email as the one line that steps forward. */
import { base } from "../lib/paths";
---

<section class="outro">
  <div class="container">
    <div class="outro-inner">
      <h2>Get in touch</h2>
      <p class="outro-line">
        I’m open to senior in-house product design roles, remote or hybrid from Porto.
      </p>
      <a class="outro-email" href="mailto:miguel.jss@gmail.com?subject=Hello%20from%20migueljss.com">
        miguel.jss@gmail.com
      </a>
      <p class="outro-secondary">
        Or find me on
        <a href="https://www.linkedin.com/in/migueljss/" target="_blank" rel="me noopener noreferrer">LinkedIn</a>,
        or open the <a href={`${base}miguel-jesus-cv.pdf`} target="_blank" rel="noopener">CV</a> (PDF).
      </p>
    </div>
  </div>
</section>

<style>
  /* Full-bleed cobalt band: the page (home and every case study) closes on
     the accent instead of fading out on paper. The color does the separating,
     so no top hairline. White-on-accent matches the hero's contrast treatment. */
  .outro {
    background: var(--accent);
    color: #fff;
    padding-block: var(--space-20);
  }

  .outro-inner {
    max-width: var(--content-narrow);
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
  }

  .outro h2 {
    color: #fff;
  }

  .outro-line {
    color: rgba(255, 255, 255, 0.92);
    margin: 0;
  }

  /* The single conversion action gets title-scale presence; everything
     around it stays at body scale so the page still ends calmly. On the
     band the email is already white, so hover lifts to the light accent
     tint and underlines rather than shifting toward a darker blue. */
  .outro-email {
    width: fit-content;
    font-family: var(--font-sans);
    font-weight: var(--weight-semi);
    font-size: clamp(var(--text-xl), 3vw, var(--text-3xl));
    letter-spacing: var(--tracking-snug);
    line-height: var(--leading-tight);
    color: #fff;
    text-decoration: none;
    margin-block: var(--space-2);
    transition: color var(--duration-fast) var(--ease-out);
  }

  .outro-email:hover {
    color: var(--accent-line);
    text-decoration: underline;
    text-decoration-thickness: var(--rule-bold);
    text-underline-offset: var(--space-1);
  }

  .outro-secondary {
    font-size: var(--text-base);
    color: rgba(255, 255, 255, 0.92);
    margin: 0;
  }

  .outro-secondary a {
    color: #fff;
    text-decoration: underline;
    text-underline-offset: 2px;
  }

  .outro-secondary a:hover {
    color: var(--accent-line);
  }
</style>
