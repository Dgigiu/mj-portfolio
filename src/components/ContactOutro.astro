---
/* Shared end-of-page contact beat: home and case study pages close on the
   same quiet invitation, with the email as the one line that steps forward. */
import { base } from "../lib/paths";
---

<section class="outro container">
  <div class="outro-inner">
    <h2>Get in touch</h2>
    <p class="outro-line">
      I'm open to senior in-house product design roles, remote or hybrid from Porto.
    </p>
    <a class="outro-email" href="mailto:miguel.jss@gmail.com?subject=Hello%20from%20migueljss.com">
      miguel.jss@gmail.com
    </a>
    <p class="outro-secondary">
      Or find me on
      <a href="https://www.linkedin.com/in/migueljss/" target="_blank" rel="me noopener noreferrer">LinkedIn</a>,
      or open the <a href={`${base}miguel-jesus-cv.pdf`} target="_blank" rel="noopener">CV</a> (PDF).
    </p>
  </div>
</section>

<style>
  .outro {
    padding-block: 0 var(--space-20);
  }

  .outro-inner {
    max-width: var(--content-narrow);
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
    padding-top: var(--space-12);
    border-top: var(--hairline) solid var(--border-subtle);
  }

  .outro-line {
    color: var(--fg-secondary);
    margin: 0;
  }

  /* The single conversion action gets title-scale presence; everything
     around it stays at body scale so the page still ends calmly. */
  .outro-email {
    width: fit-content;
    font-family: var(--font-sans);
    font-weight: var(--weight-semi);
    font-size: clamp(var(--text-xl), 3vw, var(--text-3xl));
    letter-spacing: var(--tracking-snug);
    line-height: var(--leading-tight);
    color: var(--link);
    text-decoration: none;
    margin-block: var(--space-2);
    transition: color var(--duration-fast) var(--ease-out);
  }

  .outro-email:hover {
    color: var(--link-hover);
    text-decoration: underline;
    text-decoration-thickness: var(--rule-bold);
    text-underline-offset: var(--space-1);
  }

  .outro-secondary {
    font-size: var(--text-base);
    color: var(--fg-secondary);
    margin: 0;
  }
</style>
