---
import BaseLayout from "../layouts/BaseLayout.astro";
import { base } from "../lib/paths";
---

<BaseLayout title="Page not found" description="This page doesn't exist or has moved.">
  <section class="notfound container">
    <div class="notfound-inner">
      <p class="notfound-code">404</p>
      <h1>This page doesn't exist.</h1>
      <p class="notfound-line">
        The link may be old, or the address has a typo. Everything that does exist is one step away.
      </p>
      <nav class="notfound-paths" aria-label="Helpful links">
        <a href={base}>See the work</a>
        <a href={`${base}contact/`}>Get in touch</a>
      </nav>
    </div>
  </section>
</BaseLayout>

<style>
  .notfound {
    padding-block: var(--space-24) var(--space-32);
  }

  .notfound-inner {
    max-width: var(--content-narrow);
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
  }

  .notfound-code {
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    color: var(--fg-tertiary);
    margin: 0;
  }

  .notfound-line {
    color: var(--fg-secondary);
    margin: 0;
  }

  .notfound-paths {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-6);
    margin-top: var(--space-4);
  }

  .notfound-paths a {
    font-family: var(--font-sans);
    font-size: var(--text-md);
  }
</style>
